# SilentTrack AI — Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Application Identity
APP_NAME="SilentTrack AI"
APP_VERSION="1.0.0"
DEBUG=false

# Localhost & Network Security Settings
# By default, SilentTrack AI binds strictly to localhost (127.0.0.1) so it is only
# accessible from your own computer.
# Set ENABLE_LAN_ACCESS=true (or run ./start.sh --lan / .\start.ps1 -Lan) to allow
# other devices on your trusted home/office Wi-Fi network to access the app.
HOST=127.0.0.1
PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
ENABLE_LAN_ACCESS=false

# Upload & Video Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=1800

# Temporary Storage & Automatic Cleanup
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
MIN_DISK_SPACE_MB=300

# AI Source Separation Model (HuggingFace Hub Repo ID)
MODEL_REPO_ID="JusperLee/TIGER-DnR"
DEFAULT_SEPARATION_MODE="balanced"
DEFAULT_MUSIC_REMOVAL_STRENGTH=1.0
DEFAULT_SPEECH_GAIN=1.0
DEFAULT_EFFECTS_GAIN=1.0
TORCH_NUM_THREADS=4

# Optional Explicit Binary Overrides (auto-detected if omitted)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Frontend Vite Proxy Configuration
VITE_API_BASE_URL=""
VITE_BACKEND_ORIGIN="http://127.0.0.1:8000"
